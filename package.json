{
  "name": "@areoform/felt-glass",
  "version": "0.2.0",
  "description": "Index-driven Snell optics and textured glass surfaces with independent rendering fallbacks.",
  "type": "module",
  "license": "MIT",
  "author": "Felt Glass contributors",
  "contributors": [
    {
      "name": "Codex (OpenAI coding assistant)"
    },
    {
      "name": "areoform"
    }
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./glass.js"
    },
    "./glass.css": "./glass.css",
    "./optics": {"types": "./optics.d.ts", "import": "./optics.js"}
  },
  "files": [
    "glass.js",
    "maps.js",
    "optics.js",
    "optics.d.ts",
    "OPTICS.md",
    "glass.css",
    "index.d.ts",
    "AUTHORS.md",
    "CHANGELOG.md",
    "scripts/glass-map.c",
    "scripts/glass-grain.py",
    "VALIDATION.md"
  ],
  "sideEffects": [
    "./glass.css"
  ],
  "scripts": {
    "test": "node --test tests/unit.mjs tests/optics.mjs",
    "demo": "node demo/serve.mjs",
    "test:browser": "node tests/browser.mjs",
    "release:check": "python3 scripts/release.py --check",
    "build:site": "node scripts/build-site.mjs",
    "test:reading": "node tests/reading-browser.mjs",
    "test:optics": "node tests/optics-browser.mjs"
  }
}
